+static __thread int ashell_skip_secret_lf;
+
+/* Read secrets only from the echo-free foreground virtual terminal, not
+ * a kernel tty or redirected stdin. Echo only for prompts that ask for it. */
+static char *
+ashell_read_secret(const char *prompt, char *buf, size_t size, int echo)
+{
+	struct stat st;
+	size_t len = 0;
+	int c, rejected = 0;
+	char *secret = NULL;
+	FILE *input = ios_getSecretInput();
+
+	if (input == NULL && isatty(STDIN_FILENO))
+		input = stdin;
+	if (input == NULL || fstat(fileno(input), &st) == -1 ||
+	    !(S_ISSOCK(st.st_mode) || S_ISFIFO(st.st_mode)))
+		return NULL;
+	if (fputs(prompt, stderr) == EOF || fflush(stderr) == EOF)
+		return NULL;
+	c = fgetc(input);
+	/* Consume a possible CRLF tail only when the next read is needed. */
+	if (ashell_skip_secret_lf && c == '\n')
+		c = fgetc(input);
+	ashell_skip_secret_lf = 0;
+	for (; c != EOF && c != '\r' && c != '\n'; c = fgetc(input)) {
+		if (rejected)
+			continue;
+		if (c == '\b' || c == 0x7f) {
+			if (len == 0)
+				continue;
+			/* Delete a UTF-8 code point, not just its last byte. */
+			while (--len > 0 && ((unsigned char)buf[len] & 0xc0) == 0x80)
+				continue;
+			if (echo)
+				fputs("\b \b", stderr);
+		} else {
+			if (c < ' ' || len == size - 1) {
+				/* A later prompt must not consume this line's suffix. */
+				explicit_bzero(buf, size);
+				rejected = 1;
+			} else {
+				buf[len++] = c;
+				if (echo)
+					fputc(c, stderr);
+			}
+		}
+		if (echo)
+			fflush(stderr);
+	}
+	ashell_skip_secret_lf = c == '\r';
+	if (!rejected && c != EOF) {
+		buf[len] = '\0';
+		secret = xstrdup(buf);
+	}
+	explicit_bzero(buf, size);
+	if (fputs("\r\n", stderr) == EOF || fflush(stderr) == EOF) {
+		freezero(secret, len);
+		return NULL;
+	}
+	return secret;
+}
