# Darwin/iOS configuration; positive C API choices are compile-linked for each target.
# Keep the bundled allocation/hash implementations to preserve the published ABI.
OSENUM=MANDOC_OS_OTHER
UTF8_LOCALE=en_US.UTF-8
HAVE_WFLAG=1
HAVE_STATIC=0
HAVE_NANOSLEEP=1
HAVE_DIRENT_NAMLEN=1
HAVE_ENDIAN=0
HAVE_SYS_ENDIAN=1
HAVE_EFTYPE=1
HAVE_ERR=1
HAVE_GETLINE=1
HAVE_GETSUBOPT=1
HAVE_ISBLANK=1
HAVE_MKDTEMP=1
HAVE_NTOHL=1
HAVE_O_DIRECTORY=1
HAVE_PATH_MAX=1
HAVE_PLEDGE=0
HAVE_SANDBOX_INIT=0
HAVE_PROGNAME=1
HAVE_REALLOCARRAY=0
HAVE_RECALLOCARRAY=0
HAVE_REWB_BSD=1
HAVE_REWB_SYSV=0
HAVE_STRCASESTR=1
HAVE_STRINGLIST=1
HAVE_STRLCAT=1
HAVE_STRLCPY=1
HAVE_STRNDUP=1
HAVE_STRPTIME=1
HAVE_STRSEP=1
HAVE_STRTONUM=1
HAVE_VASPRINTF=1
HAVE_FTS=1
HAVE_FTS_COMPARE_CONST=0
HAVE_LESS_T=1
HAVE_WCHAR=1
HAVE_OHASH=0
